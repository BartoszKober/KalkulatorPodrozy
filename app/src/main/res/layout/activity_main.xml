<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="#F0F0FB"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#3131bb"
        android:padding="5dp"
        >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kalkulator Podróży"
            android:textColor="#FFFFFF"
            android:textFontWeight="2000"
            android:textSize="20dp"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Autor: 00000000000"
            android:textColor="#FFFFFF"
            android:textSize="14dp"
            android:paddingLeft="30dp"
            />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dystans w km"

            />
        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/distanceEditText"
            android:hint="Dystans w km"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Zużycie paliwa na 100km"
            />
        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/consumptionEditText"
            android:hint="Zużycie paliwa na 100km"
            />
        <RadioGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/fuelRadioGroup"
            >

            <RadioButton
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Benzyna (6.50 zł)"
                />
            <RadioButton
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Diesel (6.70 zł)"
                />
            <RadioButton
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LPG (3.10 zł)"
                />
        </RadioGroup>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Zużycie paliwa na 100km"
            />
        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/passengerAmountEditText"
            android:hint="Liczba pasażerów"
            />
        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OBLICZ KOSZT"
            android:backgroundTint="@android:color/transparent"
            android:textColor="#3131bb"
            app:strokeColor="#3131bb"
            app:strokeWidth="8dp"
            app:cornerRadius="12dp"
            android:textSize="25dp"
            android:id="@+id/calculateBtn"
            />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#005300"
            android:textSize="20dp"
            android:padding="2dp"
            android:textAlignment="center"
            android:id="@+id/outputTextView"
            />

    </LinearLayout>






</LinearLayout>